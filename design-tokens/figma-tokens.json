{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "ORDEO POS — UI/UX Design System",
  "version": "1.1.0",
  "description": "Comprehensive design token library for ORDEO POS based on 55 UI/UX Design Rules across Mobile (<768px), Tablet (768–1023px), Desktop (1024–1439px), and Large Desktop (≥1440px).",
  "primitives": {
    "color": {
      "neutral": {
        "50": { "$type": "color", "$value": "#f8fafc" },
        "100": { "$type": "color", "$value": "#f1f5f9" },
        "200": { "$type": "color", "$value": "#e2e8f0" },
        "300": { "$type": "color", "$value": "#cbd5e1" },
        "400": { "$type": "color", "$value": "#94a3b8" },
        "500": { "$type": "color", "$value": "#64748b" },
        "600": { "$type": "color", "$value": "#475569" },
        "700": { "$type": "color", "$value": "#334155" },
        "800": { "$type": "color", "$value": "#1e293b" },
        "900": { "$type": "color", "$value": "#0f172a" }
      },
      "primary": {
        "50": { "$type": "color", "$value": "#fff7ed" },
        "100": { "$type": "color", "$value": "#ffedd5" },
        "200": { "$type": "color", "$value": "#fed7aa" },
        "300": { "$type": "color", "$value": "#fdba74" },
        "400": { "$type": "color", "$value": "#fb923c" },
        "500": { "$type": "color", "$value": "#f97316", "$description": "ORDEO Vibrant Orange" },
        "600": { "$type": "color", "$value": "#ea580c" },
        "700": { "$type": "color", "$value": "#c2410c" },
        "800": { "$type": "color", "$value": "#9a3412" },
        "900": { "$type": "color", "$value": "#7c2d12" }
      },
      "success": {
        "50": { "$type": "color", "$value": "#ecfdf5" },
        "500": { "$type": "color", "$value": "#10b981" },
        "600": { "$type": "color", "$value": "#059669" },
        "700": { "$type": "color", "$value": "#047857" }
      },
      "warning": {
        "50": { "$type": "color", "$value": "#fffbeb" },
        "500": { "$type": "color", "$value": "#f59e0b" },
        "600": { "$type": "color", "$value": "#d97706" }
      },
      "danger": {
        "50": { "$type": "color", "$value": "#fff1f2" },
        "500": { "$type": "color", "$value": "#f43f5e" },
        "600": { "$type": "color", "$value": "#e11d48" },
        "700": { "$type": "color", "$value": "#be123c" }
      }
    },
    "spacing": {
      "4": { "$type": "dimension", "$value": "4px" },
      "8": { "$type": "dimension", "$value": "8px" },
      "12": { "$type": "dimension", "$value": "12px" },
      "16": { "$type": "dimension", "$value": "16px" },
      "24": { "$type": "dimension", "$value": "24px" },
      "32": { "$type": "dimension", "$value": "32px" },
      "40": { "$type": "dimension", "$value": "40px" },
      "48": { "$type": "dimension", "$value": "48px" },
      "64": { "$type": "dimension", "$value": "64px" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "8px" },
      "md": { "$type": "dimension", "$value": "12px" },
      "lg": { "$type": "dimension", "$value": "16px" },
      "xl": { "$type": "dimension", "$value": "24px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "fontFamily": {
      "thai": { "$type": "fontFamily", "$value": "Prompt, -apple-system, sans-serif" },
      "latin": { "$type": "fontFamily", "$value": "Plus Jakarta Sans, sans-serif" }
    }
  },
  "semantic": {
    "viewports": {
      "mobile": {
        "range": { "$type": "string", "$value": "< 768px" },
        "containerPadding": { "$type": "dimension", "$value": "16px" },
        "productGridCols": { "$type": "number", "$value": 2 },
        "tableGridCols": { "$type": "number", "$value": 2 },
        "typography": {
          "h1": { "fontSize": "20px", "lineHeight": "1.25", "fontWeight": "700" },
          "h2": { "fontSize": "18px", "lineHeight": "1.3", "fontWeight": "700" },
          "h3": { "fontSize": "16px", "lineHeight": "1.35", "fontWeight": "600" },
          "body": { "fontSize": "16px", "lineHeight": "1.5", "fontWeight": "400" },
          "small": { "fontSize": "14px", "lineHeight": "1.4", "fontWeight": "500" }
        },
        "button": {
          "minTouchTarget": { "$type": "dimension", "$value": "44px" },
          "recommendedPos": { "$type": "dimension", "$value": "48px" },
          "primaryAction": { "$type": "dimension", "$value": "56px" },
          "adjacentSpacing": { "$type": "dimension", "$value": "8px" }
        },
        "input": {
          "minHeight": { "$type": "dimension", "$value": "44px" },
          "recommendedHeight": { "$type": "dimension", "$value": "48px" },
          "fontSize": { "$type": "dimension", "$value": "16px", "$description": "Prevents iOS zoom" }
        },
        "navigation": { "$type": "string", "$value": "Bottom Navigation Bar + Bottom Sheet" }
      },
      "tablet": {
        "range": { "$type": "string", "$value": "768px – 1023px" },
        "containerPadding": { "$type": "dimension", "$value": "24px" },
        "productGridCols": { "$type": "string", "$value": "3–4 columns" },
        "tableGridCols": { "$type": "string", "$value": "3–4 columns" },
        "typography": {
          "h1": { "fontSize": "22px", "lineHeight": "1.25", "fontWeight": "700" },
          "h2": { "fontSize": "20px", "lineHeight": "1.3", "fontWeight": "700" },
          "h3": { "fontSize": "16px", "lineHeight": "1.35", "fontWeight": "600" },
          "body": { "fontSize": "16px", "lineHeight": "1.5", "fontWeight": "400" },
          "small": { "fontSize": "14px", "lineHeight": "1.4", "fontWeight": "500" }
        },
        "button": {
          "minTouchTarget": { "$type": "dimension", "$value": "44px" },
          "recommendedPos": { "$type": "dimension", "$value": "48px" },
          "primaryAction": { "$type": "dimension", "$value": "56px" },
          "adjacentSpacing": { "$type": "dimension", "$value": "10px" }
        },
        "navigation": { "$type": "string", "$value": "Collapsed Sidebar or Top Glass Navigation" }
      },
      "desktop": {
        "range": { "$type": "string", "$value": "1024px – 1439px" },
        "containerPadding": { "$type": "dimension", "$value": "24px–32px" },
        "productGridCols": { "$type": "string", "$value": "4–6 columns" },
        "tableGridCols": { "$type": "string", "$value": "5–6 columns" },
        "typography": {
          "h1": { "fontSize": "24px", "lineHeight": "1.2", "fontWeight": "800" },
          "h2": { "fontSize": "20px", "lineHeight": "1.25", "fontWeight": "700" },
          "h3": { "fontSize": "16px", "lineHeight": "1.35", "fontWeight": "600" },
          "body": { "fontSize": "16px", "lineHeight": "1.5", "fontWeight": "400" },
          "small": { "fontSize": "14px", "lineHeight": "1.4", "fontWeight": "500" }
        },
        "button": {
          "minTouchTarget": { "$type": "dimension", "$value": "36px" },
          "recommendedPos": { "$type": "dimension", "$value": "44px" },
          "primaryAction": { "$type": "dimension", "$value": "48px" },
          "adjacentSpacing": { "$type": "dimension", "$value": "12px" }
        },
        "navigation": { "$type": "string", "$value": "Top Glass Navbar / Sidebar" }
      },
      "largeDesktop": {
        "range": { "$type": "string", "$value": "≥ 1440px" },
        "containerMaxWidth": { "$type": "dimension", "$value": "1440px" },
        "productGridCols": { "$type": "string", "$value": "6+ columns" }
      }
    }
  }
}
