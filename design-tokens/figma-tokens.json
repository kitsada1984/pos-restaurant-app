{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "ORDEO Restaurant POS Design System",
  "version": "1.0.0",
  "description": "Design tokens library for ORDEO Restaurant POS platform, covering Desktop (PC), Tablet, and Mobile viewport scales according to figma-generate-library standards.",
  "primitives": {
    "color": {
      "neutral": {
        "50": { "$type": "color", "$value": "#f8fafc" },
        "100": { "$type": "color", "$value": "#f1f5f9" },
        "200": { "$type": "color", "$value": "#e2e8f0" },
        "300": { "$type": "color", "$value": "#cbd5e1" },
        "400": { "$type": "color", "$value": "#94a3b8" },
        "500": { "$type": "color", "$value": "#64748b" },
        "600": { "$type": "color", "$value": "#475569" },
        "700": { "$type": "color", "$value": "#334155" },
        "800": { "$type": "color", "$value": "#1e293b" },
        "900": { "$type": "color", "$value": "#0f172a" }
      },
      "primary": {
        "50": { "$type": "color", "$value": "#fff7ed" },
        "100": { "$type": "color", "$value": "#ffedd5" },
        "200": { "$type": "color", "$value": "#fed7aa" },
        "300": { "$type": "color", "$value": "#fdba74" },
        "400": { "$type": "color", "$value": "#fb923c" },
        "500": { "$type": "color", "$value": "#f97316", "$description": "Vibrant Thai Food Orange" },
        "600": { "$type": "color", "$value": "#ea580c" },
        "700": { "$type": "color", "$value": "#c2410c" },
        "800": { "$type": "color", "$value": "#9a3412" },
        "900": { "$type": "color", "$value": "#7c2d12" }
      },
      "success": {
        "50": { "$type": "color", "$value": "#ecfdf5" },
        "500": { "$type": "color", "$value": "#10b981" },
        "600": { "$type": "color", "$value": "#059669" },
        "700": { "$type": "color", "$value": "#047857" }
      },
      "danger": {
        "50": { "$type": "color", "$value": "#fff1f2" },
        "500": { "$type": "color", "$value": "#f43f5e" },
        "600": { "$type": "color", "$value": "#e11d48" },
        "700": { "$type": "color", "$value": "#be123c" }
      }
    },
    "spacing": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "2-5": { "$type": "dimension", "$value": "10px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "3-5": { "$type": "dimension", "$value": "14px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0px" },
      "sm": { "$type": "dimension", "$value": "4px" },
      "md": { "$type": "dimension", "$value": "8px" },
      "lg": { "$type": "dimension", "$value": "12px" },
      "xl": { "$type": "dimension", "$value": "16px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "fontFamily": {
      "thai": { "$type": "fontFamily", "$value": "Prompt, -apple-system, sans-serif" },
      "latin": { "$type": "fontFamily", "$value": "Plus Jakarta Sans, sans-serif" }
    }
  },
  "semantic": {
    "viewport": {
      "mobile": {
        "breakpoint": { "$type": "dimension", "$value": "640px", "$description": "Mobile screen max width" },
        "containerPadding": { "$type": "dimension", "$value": "{primitives.spacing.3}" },
        "gridGap": { "$type": "dimension", "$value": "{primitives.spacing.2-5}" },
        "modalWidth": { "$type": "dimension", "$value": "94vw" },
        "typography": {
          "h1": { "$type": "dimension", "$value": "20px", "lineHeight": "28px", "fontWeight": "700" },
          "h2": { "$type": "dimension", "$value": "18px", "lineHeight": "24px", "fontWeight": "700" },
          "h3": { "$type": "dimension", "$value": "16px", "lineHeight": "22px", "fontWeight": "600" },
          "body": { "$type": "dimension", "$value": "14px", "lineHeight": "20px", "fontWeight": "400" },
          "caption": { "$type": "dimension", "$value": "12px", "lineHeight": "16px", "fontWeight": "500" }
        },
        "button": {
          "minTouchTarget": { "$type": "dimension", "$value": "44px" },
          "primaryHeight": { "$type": "dimension", "$value": "48px" },
          "secondaryHeight": { "$type": "dimension", "$value": "40px" },
          "paddingX": { "$type": "dimension", "$value": "{primitives.spacing.4}" },
          "paddingY": { "$type": "dimension", "$value": "{primitives.spacing.3}" },
          "fontSize": { "$type": "dimension", "$value": "15px" },
          "fontWeight": { "$type": "fontWeight", "$value": "600" }
        }
      },
      "tablet": {
        "breakpoint": { "$type": "dimension", "$value": "1024px", "$description": "Tablet screen range 640px to 1024px" },
        "containerPadding": { "$type": "dimension", "$value": "{primitives.spacing.4}" },
        "gridGap": { "$type": "dimension", "$value": "{primitives.spacing.3-5}" },
        "modalWidth": { "$type": "dimension", "$value": "512px" },
        "typography": {
          "h1": { "$type": "dimension", "$value": "22px", "lineHeight": "30px", "fontWeight": "700" },
          "h2": { "$type": "dimension", "$value": "18px", "lineHeight": "26px", "fontWeight": "700" },
          "h3": { "$type": "dimension", "$value": "16px", "lineHeight": "22px", "fontWeight": "600" },
          "body": { "$type": "dimension", "$value": "14px", "lineHeight": "20px", "fontWeight": "400" },
          "caption": { "$type": "dimension", "$value": "12px", "lineHeight": "16px", "fontWeight": "500" }
        },
        "button": {
          "minTouchTarget": { "$type": "dimension", "$value": "44px" },
          "primaryHeight": { "$type": "dimension", "$value": "44px" },
          "secondaryHeight": { "$type": "dimension", "$value": "38px" },
          "paddingX": { "$type": "dimension", "$value": "{primitives.spacing.4}" },
          "paddingY": { "$type": "dimension", "$value": "{primitives.spacing.2-5}" },
          "fontSize": { "$type": "dimension", "$value": "14px" },
          "fontWeight": { "$type": "fontWeight", "$value": "600" }
        }
      },
      "desktop": {
        "breakpoint": { "$type": "dimension", "$value": "1440px", "$description": "Desktop PC screen 1024px+" },
        "containerPadding": { "$type": "dimension", "$value": "{primitives.spacing.6}" },
        "gridGap": { "$type": "dimension", "$value": "{primitives.spacing.4}" },
        "modalWidth": { "$type": "dimension", "$value": "640px" },
        "typography": {
          "h1": { "$type": "dimension", "$value": "24px", "lineHeight": "32px", "fontWeight": "700" },
          "h2": { "$type": "dimension", "$value": "20px", "lineHeight": "28px", "fontWeight": "700" },
          "h3": { "$type": "dimension", "$value": "16px", "lineHeight": "24px", "fontWeight": "600" },
          "body": { "$type": "dimension", "$value": "14px", "lineHeight": "20px", "fontWeight": "400" },
          "caption": { "$type": "dimension", "$value": "12px", "lineHeight": "16px", "fontWeight": "500" }
        },
        "button": {
          "minTouchTarget": { "$type": "dimension", "$value": "36px" },
          "primaryHeight": { "$type": "dimension", "$value": "40px" },
          "secondaryHeight": { "$type": "dimension", "$value": "36px" },
          "paddingX": { "$type": "dimension", "$value": "{primitives.spacing.3-5}" },
          "paddingY": { "$type": "dimension", "$value": "{primitives.spacing.2}" },
          "fontSize": { "$type": "dimension", "$value": "14px" },
          "fontWeight": { "$type": "fontWeight", "$value": "500" }
        }
      }
    }
  },
  "components": {
    "button": {
      "primary": {
        "background": "{primitives.color.primary.500}",
        "hoverBackground": "{primitives.color.primary.600}",
        "color": "#ffffff",
        "borderRadius": "{primitives.radius.xl}",
        "shadow": "0 2px 4px rgba(249, 115, 22, 0.2)",
        "activeScale": "0.96",
        "transition": "60ms cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "secondary": {
        "background": "{primitives.color.neutral.100}",
        "hoverBackground": "{primitives.color.neutral.200}",
        "color": "{primitives.color.neutral.800}",
        "borderRadius": "{primitives.radius.xl}",
        "activeScale": "0.96",
        "transition": "60ms cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "destructive": {
        "background": "{primitives.color.danger.50}",
        "hoverBackground": "{primitives.color.danger.600}",
        "color": "{primitives.color.danger.600}",
        "hoverColor": "#ffffff",
        "borderRadius": "{primitives.radius.xl}",
        "activeScale": "0.96",
        "transition": "60ms cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "success": {
        "background": "{primitives.color.success.500}",
        "hoverBackground": "{primitives.color.success.600}",
        "color": "#ffffff",
        "borderRadius": "{primitives.radius.xl}",
        "activeScale": "0.96",
        "transition": "60ms cubic-bezier(0.16, 1, 0.3, 1)"
      }
    }
  }
}
