# ==========================================
# POS Restaurant App - Environment Variables
# ==========================================

# 1. Database Connections (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&schema=pos_restaurant"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=pos_restaurant"

# 2. Authentication Security (Required - Min 32 characters)
# ใช้สำหรับเซ็นชื่อ JWT Token ป้องกันการปลอมแปลงสิทธิ์ Staff / Admin
# แนะนำสุ่มรหัสความยาว 64 ตัวอักษร เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate-a-secure-64-character-hex-secret-key-here"

# 3. Optional Services (ตั้งค่าผ่านหน้า Admin Settings หรือระบุที่นี่ได้)
# SLIP_PROVIDER="HYBRID" # HYBRID, INTERNAL, SLIPOK, EASYSLIP
# SLIPOK_API_KEY=""
# SLIPOK_BRANCH_ID=""
