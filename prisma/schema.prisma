generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// 1. ระบบจัดการแพลตฟอร์ม & สมาชิก (Platform & SaaS Auth)
// ----------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("STORE_OWNER") // SUPER_ADMIN, STORE_OWNER, STORE_STAFF
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Store {
  id              String         @id @default(cuid())
  slug            String         @unique // เช่น "lung-pa", "zaab-cafe"
  name            String         // เช่น "ร้านอาหารตามสั่ง ลุง-ป้า"
  description     String?
  status          String         @default("TRIAL") // TRIAL, ACTIVE, PENDING_PAYMENT, SUSPENDED, EXPIRED
  trialEndsAt     DateTime
  subscriptionEnd DateTime
  planId          String?
  plan            Plan?          @relation(fields: [planId], references: [id])
  
  // การตั้งค่าร้านค้า & บัญชีรับเงินของร้านนั้นๆ
  promptPayId     String         @default("")
  promptPayName   String         @default("")
  phone           String?
  address         String?
  receiptFooter   String?        @default("ขอบคุณที่อุดหนุนครับ/ค่ะ โอกาสหน้าเชิญใหม่")
  tableCount      Int            @default(10)
  
  // การตั้งค่าระบบสมาชิกสะสมแต้ม (Loyalty Points Settings)
  pointsRate      Float          @default(25) // ยอดซื้อทุกกี่บาท = 1 แต้ม (ค่าเริ่มต้น 25 บ.)
  pointValue      Float          @default(1)  // 1 แต้ม = แลกส่วนลดได้กี่บาท (ค่าเริ่มต้น 1 บ.)
  
  // ความสัมพันธ์ข้อมูลของร้าน
  users           User[]
  categories      Category[]
  menuItems       MenuItem[]
  tables          Table[]
  orders          Order[]
  subscriptions   SubscriptionHistory[]
  ingredients     Ingredient[]
  stockLogs       StockLog[]
  members         CustomerMember[]
  promotions      Promotion[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Plan {
  id           String                @id @default(cuid())
  name         String                // เช่น "Basic รายเดือน (1 เดือน)", "Pro (6 เดือน)", "Unlimited รายปี (1 ปี)"
  price        Float                 @default(0) // ราคาแพ็กเกจ (บาท)
  durationDays Int                   @default(30)
  maxTables    Int                   @default(15)
  description  String?
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  stores       Store[]
  subscriptions SubscriptionHistory[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model SubscriptionHistory {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id])
  amount     Float
  slipUrl    String?   // สลิปหลักฐานโอนเงิน
  note       String?
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt DateTime?
  approvedBy String?   // ชื่อหรือ ID ของ Super Admin
  createdAt  DateTime  @default(now())
}

model PlatformSetting {
  id              String   @id @default("default")
  platformName    String   @default("ORDEO SaaS POS")
  bankName        String   @default("ธนาคารกสิกรไทย (KBANK)")
  bankAccountNo   String   @default("123-4-56789-0")
  bankAccountName String   @default("บจก. ออร์เดียโอ โซลูชั่นส์")
  promptPayId     String   @default("0812345678")
  contactLine     String   @default("@ordeopos")
  contactPhone    String   @default("081-234-5678")
  updatedAt       DateTime @updatedAt
}

// ----------------------------------------------------
// 2. ข้อมูลเฉพาะของแต่ละร้าน (Tenant Scoped Models)
// ----------------------------------------------------

model Table {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableNo          Int      // โต๊ะหมายเลข 1, 2, 3...
  name             String   // "โต๊ะ 1", "VIP 1"
  status           String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, PAYMENT_PENDING
  currentSessionId String?
  updatedAt        DateTime @updatedAt
  orders           Order[]

  @@unique([storeId, tableNo])
}

model Category {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String     // เช่น "ผัดกะเพรา / ผัดพริกแกง", "ข้าวผัด", "เครื่องดื่ม"
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  basePrice   Float             @default(50)
  imageUrl    String?
  isAvailable Boolean           @default(true) // สำหรับปุ่ม 1-click "ของหมด"
  sortOrder   Int               @default(0)
  options     MenuOptionGroup[]
  orderItems  OrderItem[]
  recipes     MenuItemRecipe[]
}

model MenuOptionGroup {
  id         String             @id @default(cuid())
  menuItemId String
  menuItem   MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  title      String             // เช่น "เลือกเนื้อสัตว์", "เพิ่มไข่", "ระดับความเผ็ด"
  isRequired Boolean            @default(false)
  isMulti    Boolean            @default(false)
  choices    MenuOptionChoice[]
}

model MenuOptionChoice {
  id            String          @id @default(cuid())
  optionGroupId String
  optionGroup   MenuOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name          String          // เช่น "หมูกรอบ", "ไข่ดาวไม่สุก", "เผ็ดมาก"
  extraPrice    Float           @default(0)
}

// ----------------------------------------------------
// 3. ระบบคลังวัตถุดิบ & สูตรอาหาร (Inventory & Recipe BOM)
// ----------------------------------------------------

model Ingredient {
  id            String           @id @default(cuid())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String           // เช่น "หมูสับ", "เนื้อวัว", "ไข่ไก่", "ใบกะเพรา", "ข้าวสาร", "พริกสด"
  unit          String           // เช่น "กรัม (g)", "ฟอง", "มล. (ml)", "กิโลกรัม (kg)"
  costPerUnit   Float            @default(0) // ต้นทุนต่อหน่วย (บาท)
  currentStock  Float            @default(0) // จำนวนคงเหลือ
  minStockAlert Float            @default(10) // เกณฑ์เตือนของใกล้หมด
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  recipes       MenuItemRecipe[]
  stockLogs     StockLog[]
}

model MenuItemRecipe {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float      @default(1) // ปริมาณที่ใช้ต่อ 1 จาน (เช่น 150g, 1 ฟอง)

  @@unique([menuItemId, ingredientId])
}

model StockLog {
  id           String     @id @default(cuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  changeQty    Float      // เช่น +5000 (รับเข้า) หรือ -150 (ขาย)
  reason       String     // STOCK_IN, ORDER, ADJUST, SPOILAGE
  cost         Float?
  note         String?
  createdAt    DateTime   @default(now())
}

// ----------------------------------------------------
// 4. ระบบสมาชิกสะสมแต้ม & คูปองโปรโมชั่น (Loyalty CRM & Promo)
// ----------------------------------------------------

model CustomerMember {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phone      String   // เบอร์โทรศัพท์สำหรับสะสมแต้ม
  name       String?  // ชื่อลูกค้า
  points     Int      @default(0) // แต้มสะสมคงเหลือ
  totalSpent Float    @default(0) // ยอดซื้อสะสมรวมทั้งหมด
  visitCount Int      @default(0) // จำนวนครั้งที่มาใช้บริการ
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([storeId, phone])
}

model Promotion {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String    // เช่น "WELCOME50", "DISC10"
  title         String    // เช่น "ส่วนลดเปิดร้านใหม่ 50 บาท"
  discountType  String    @default("FIXED") // FIXED (บาท), PERCENT (%)
  discountValue Float     // เช่น 50 หรือ 10
  minSpend      Float     @default(0) // ยอดสั่งซื้อขั้นต่ำ
  isActive      Boolean   @default(true)
  expiryDate    DateTime?
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, code])
}

// ----------------------------------------------------
// 5. ออเดอร์และรายการสั่งอาหาร (Orders & Order Items)
// ----------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableId        String?
  table          Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableNo        Int         @default(1)
  status         String      @default("PENDING") // PENDING, COOKING, READY, SERVED, COMPLETED, CANCELLED
  orderType      String      @default("DINE_IN") // DINE_IN, TAKEAWAY
  totalAmount    Float       @default(0)
  discountAmount Float       @default(0)
  netAmount      Float       @default(0)
  costAmount     Float       @default(0) // ต้นทุนวัตถุดิบรวมสำหรับคำนวณกำไร COGS
  
  // การสะสมแต้ม & ส่วนลดโปรโมชั่น
  memberPhone    String?
  pointsEarned   Int         @default(0)
  pointsRedeemed Int         @default(0)
  promoCode      String?
  
  paymentMethod  String?     // CASH, PROMPTPAY
  paymentStatus  String      @default("UNPAID") // UNPAID, PENDING_CONFIRMATION, PAID
  slipUrl        String?     // รูปภาพสลิปที่ลูกค้าแนบ
  cashReceived   Float?
  changeAmount   Float?
  customerLineId String?
  customerName   String?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  paidAt         DateTime?
  items          OrderItem[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  name            String
  price           Float
  quantity        Int      @default(1)
  selectedOptions String?  // JSON text: e.g. [{"group":"เนื้อสัตว์","choice":"หมูกรอบ","extra":15}]
  specialNote     String?  // เช่น "ไม่ใส่ผัก ไม่ใส่ชูรส"
  status          String   @default("PENDING") // PENDING, COOKING, READY, SERVED
  createdAt       DateTime @default(now())
}
