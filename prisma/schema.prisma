generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// 1. ระบบจัดการแพลตฟอร์ม & สมาชิก (Platform & SaaS Auth)
// ----------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("STORE_OWNER") // SUPER_ADMIN, STORE_OWNER, STORE_STAFF
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Store {
  id              String         @id @default(cuid())
  slug            String         @unique // เช่น "lung-pa", "zaab-cafe"
  name            String         // เช่น "ร้านอาหารตามสั่ง ลุง-ป้า"
  description     String?
  status          String         @default("TRIAL") // TRIAL, ACTIVE, PENDING_PAYMENT, SUSPENDED, EXPIRED
  trialEndsAt     DateTime
  subscriptionEnd DateTime
  planId          String?
  plan            Plan?          @relation(fields: [planId], references: [id])
  
  // การตั้งค่าร้านค้า & บัญชีรับเงินของร้านนั้นๆ
  promptPayId     String         @default("")
  promptPayName   String         @default("")
  phone           String?
  address         String?
  receiptFooter   String?        @default("ขอบคุณที่อุดหนุนครับ/ค่ะ โอกาสหน้าเชิญใหม่")
  tableCount      Int            @default(10)
  
  // ความสัมพันธ์ข้อมูลของร้าน
  users           User[]
  categories      Category[]
  menuItems       MenuItem[]
  tables          Table[]
  orders          Order[]
  subscriptions   SubscriptionHistory[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Plan {
  id           String                @id @default(cuid())
  name         String                // เช่น "Basic รายเดือน (1 เดือน)", "Pro (6 เดือน)", "Unlimited รายปี (1 ปี)"
  price        Float                 @default(0) // ราคาแพ็กเกจ (บาท)
  durationDays Int                   @default(30)
  maxTables    Int                   @default(15)
  description  String?
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  stores       Store[]
  subscriptions SubscriptionHistory[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model SubscriptionHistory {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id])
  amount     Float
  slipUrl    String?   // สลิปหลักฐานโอนเงิน
  note       String?
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt DateTime?
  approvedBy String?   // ชื่อหรือ ID ของ Super Admin
  createdAt  DateTime  @default(now())
}

model PlatformSetting {
  id              String   @id @default("default")
  platformName    String   @default("ORDEO SaaS POS")
  bankName        String   @default("ธนาคารกสิกรไทย (KBANK)")
  bankAccountNo   String   @default("123-4-56789-0")
  bankAccountName String   @default("บจก. ออร์เดียโอ โซลูชั่นส์")
  promptPayId     String   @default("0812345678")
  contactLine     String   @default("@ordeopos")
  contactPhone    String   @default("081-234-5678")
  updatedAt       DateTime @updatedAt
}

// ----------------------------------------------------
// 2. ข้อมูลเฉพาะของแต่ละร้าน (Tenant Scoped Models)
// ----------------------------------------------------

model Table {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableNo          Int      // โต๊ะหมายเลข 1, 2, 3...
  name             String   // "โต๊ะ 1", "VIP 1"
  status           String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, PAYMENT_PENDING
  currentSessionId String?
  updatedAt        DateTime @updatedAt
  orders           Order[]

  @@unique([storeId, tableNo])
}

model Category {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String     // เช่น "ผัดกะเพรา / ผัดพริกแกง", "ข้าวผัด", "เครื่องดื่ม"
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  basePrice   Float             @default(50)
  imageUrl    String?
  isAvailable Boolean           @default(true) // สำหรับปุ่ม 1-click "ของหมด"
  sortOrder   Int               @default(0)
  options     MenuOptionGroup[]
  orderItems  OrderItem[]
}

model MenuOptionGroup {
  id         String             @id @default(cuid())
  menuItemId String
  menuItem   MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  title      String             // เช่น "เลือกเนื้อสัตว์", "เพิ่มไข่", "ระดับความเผ็ด"
  isRequired Boolean            @default(false)
  isMulti    Boolean            @default(false)
  choices    MenuOptionChoice[]
}

model MenuOptionChoice {
  id            String          @id @default(cuid())
  optionGroupId String
  optionGroup   MenuOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name          String          // เช่น "หมูกรอบ", "ไข่ดาวไม่สุก", "เผ็ดมาก"
  extraPrice    Float           @default(0)
}

model Order {
  id             String      @id @default(cuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableId        String?
  table          Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableNo        Int         @default(1)
  status         String      @default("PENDING") // PENDING, COOKING, READY, SERVED, COMPLETED, CANCELLED
  orderType      String      @default("DINE_IN") // DINE_IN, TAKEAWAY
  totalAmount    Float       @default(0)
  discountAmount Float       @default(0)
  netAmount      Float       @default(0)
  paymentMethod  String?     // CASH, PROMPTPAY
  paymentStatus  String      @default("UNPAID") // UNPAID, PENDING_CONFIRMATION, PAID
  slipUrl        String?     // รูปภาพสลิปที่ลูกค้าแนบ
  cashReceived   Float?
  changeAmount   Float?
  customerLineId String?
  customerName   String?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  paidAt         DateTime?
  items          OrderItem[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  name            String
  price           Float
  quantity        Int      @default(1)
  selectedOptions String?  // JSON text: e.g. [{"group":"เนื้อสัตว์","choice":"หมูกรอบ","extra":15}]
  specialNote     String?  // เช่น "ไม่ใส่ผัก ไม่ใส่ชูรส"
  status          String   @default("PENDING") // PENDING, COOKING, READY, SERVED
  createdAt       DateTime @default(now())
}
